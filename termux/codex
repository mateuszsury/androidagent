#!/data/data/com.termux/files/usr/bin/bash
# androidagent fork: supports ARM64 phones and x86_64 emulators; no root required.
set -eu
P=/data/data/com.termux/files/usr
case "$(uname -m)" in
  aarch64|arm64) PLATFORM=linux-arm64; TRIPLE=aarch64-unknown-linux-musl ;;
  x86_64) PLATFORM=linux-x64; TRIPLE=x86_64-unknown-linux-musl ;;
  *) echo 'androidagent supports 64-bit ARM and x86 Android only.' >&2; exit 1 ;;
esac
ROOT=$(npm root -g)
BIN=$ROOT/@openai/codex/node_modules/@openai/codex-$PLATFORM/vendor/$TRIPLE/bin/codex
# Some npm versions hoist the optional platform package.
[ -x "$BIN" ] || BIN=$ROOT/@openai/codex-$PLATFORM/vendor/$TRIPLE/bin/codex
if [ ! -x "$BIN" ]; then
  echo "Missing Codex binary. Install the matching @openai/codex-$PLATFORM package, then retry." >&2
  exit 1
fi
exec proot -b "$P/etc/resolv.conf:/etc/resolv.conf" -b "$P/etc/tls:/etc/ssl" "$BIN" "$@"
